# Fails when a source file outside src/platform/ includes an SDL header. Run with -DENGINE_DIR=<engine folder>.
file(GLOB_RECURSE sources "${ENGINE_DIR}/src/*.cpp" "${ENGINE_DIR}/src/*.hpp" "${ENGINE_DIR}/src/*.h")
set(offenders "")
foreach(path IN LISTS sources)
    file(RELATIVE_PATH relative "${ENGINE_DIR}/src" "${path}")
    if(relative MATCHES "^platform/")
        continue()
    endif()
    file(STRINGS "${path}" hits REGEX "^[ \t]*#[ \t]*include[ \t]*[<\"]SDL")
    if(hits)
        list(APPEND offenders "src/${relative}")
    endif()
endforeach()
if(offenders)
    list(JOIN offenders "\n  " listed)
    message(FATAL_ERROR "SDL headers included outside src/platform/:\n  ${listed}")
endif()
message(STATUS "SDL headers are confined to src/platform/")
