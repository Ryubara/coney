{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "uv run --no-project --python \">=3.12\" python \"$CLAUDE_PROJECT_DIR/.claude/hooks/dispatch.py\" || exit 0",
            "timeout": 200
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "uv run --no-project --python \">=3.12\" python \"$CLAUDE_PROJECT_DIR/.claude/hooks/dispatch.py\" || exit 0",
            "timeout": 20
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "startup|resume|clear",
        "hooks": [
          {
            "type": "command",
            "command": "uv run --no-project --python \">=3.12\" python \"$CLAUDE_PROJECT_DIR/.claude/hooks/dispatch.py\" || exit 0",
            "timeout": 20
          }
        ]
      }
    ],
    "PostToolUseFailure": [
      {
        "matcher": "Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "uv run --no-project --python \">=3.12\" python \"$CLAUDE_PROJECT_DIR/.claude/hooks/dispatch.py\" || exit 0",
            "timeout": 20
          }
        ]
      }
    ],
    "PermissionDenied": [
      {
        "matcher": "Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "uv run --no-project --python \">=3.12\" python \"$CLAUDE_PROJECT_DIR/.claude/hooks/dispatch.py\" || exit 0",
            "timeout": 20
          }
        ]
      }
    ]
  },
  "permissions": {
    "allow": [
      "Bash(uv run --project python coney-tools config show*)",
      "Bash(uv run --project python coney-tools repo check*)",
      "Bash(uv run --project python coney-tools missions render*)",
      "Bash(uv run --project python coney-tools natives render*)",
      "Bash(uv run --project python coney-tools refs render*)",
      "Bash(uv run --project python coney-tools research render*)",
      "Bash(uv run --project python coney-tools research where*)",
      "Bash(uv run --project python coney-tools research import-table*)",
      "Bash(uv run --project python coney-tools progress show*)",
      "Bash(uv run --project python pytest *)",
      "Bash(uv run --project python ruff *)",
      "Bash(uv run --project python mypy *)",
      "Bash(uvx pre-commit run *)",
      "Bash(uv run --project python coney-tools build*)",
      "Bash(export CONEY_AGENT_TOKEN=*)",
      "PowerShell(uv run --project python coney-tools config show*)",
      "PowerShell(uv run --project python coney-tools repo check*)",
      "PowerShell(uv run --project python pytest *)",
      "PowerShell(uv run --project python coney-tools build*)"
    ],
    "deny": [
      "Bash(git stash *)",
      "Bash(pkill *)",
      "Bash(killall *)",
      "Bash(taskkill /IM *)",
      "Bash(taskkill /im *)",
      "PowerShell(git stash *)",
      "PowerShell(taskkill /IM *)",
      "PowerShell(taskkill /im *)",
      "PowerShell(Stop-Process -Name *)",
      "Bash(gh *.mp4*)",
      "Bash(gh *.webm*)",
      "Bash(gh *.mov*)",
      "Bash(gh *.mkv*)",
      "PowerShell(gh *.mp4*)",
      "PowerShell(gh *.webm*)",
      "PowerShell(gh *.mov*)",
      "PowerShell(gh *.mkv*)"
    ]
  }
}
