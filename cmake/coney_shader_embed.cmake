# Run by the build, in script mode (cmake -P), to write the C++ data file that holds the compiled shaders:
#   cmake -DOUTPUT=<file.inc> -DFOLDER=<where the compiled shaders are> -DSHADERS=<name:stage,...> -P
#         coney_shader_embed.cmake
# For each shader `name` (such as `fullscreen.vert`), FOLDER holds name.spv, name.dxil, name.msl and name.json (the
# resource counts of SDL's GPU API, from the tool's reflection). The file defines `kShaders`, an array of
# coney::shaders::Shader, and is included by src/platform/shaders/embedded_shaders.cpp.
foreach(_var OUTPUT FOLDER SHADERS)
    if(NOT DEFINED ${_var})
        message(FATAL_ERROR "coney_shader_embed.cmake: ${_var} is not set")
    endif()
endforeach()

string(REPLACE "," ";" SHADERS "${SHADERS}")
set(_data "")
set(_table "")
set(_index 0)
foreach(_entry IN LISTS SHADERS)
    string(REPLACE ":" ";" _parts "${_entry}")
    list(GET _parts 0 _name)
    list(GET _parts 1 _stage)
    string(SUBSTRING "${_stage}" 0 1 _first)
    string(TOUPPER "${_first}" _first)
    string(SUBSTRING "${_stage}" 1 -1 _rest)

    file(READ "${FOLDER}/${_name}.json" _json)
    string(JSON _samplers GET "${_json}" samplers)
    string(JSON _storage_textures GET "${_json}" storage_textures)
    string(JSON _storage_buffers GET "${_json}" storage_buffers)
    string(JSON _uniform_buffers GET "${_json}" uniform_buffers)

    set(_spans "")
    foreach(_extension spv dxil msl)
        file(READ "${FOLDER}/${_name}.${_extension}" _hex HEX)
        string(LENGTH "${_hex}" _hex_length)
        if(_hex_length EQUAL 0)
            message(FATAL_ERROR "${_name}.${_extension} is empty")
        endif()
        # Two hex digits a byte, sixteen bytes to a line.
        string(REGEX REPLACE "([0-9a-f][0-9a-f])" "0x\1," _bytes "${_hex}")
        string(REGEX REPLACE "(0x[0-9a-f][0-9a-f],){16}" "\0\n    " _bytes "${_bytes}")
        string(APPEND _data "constexpr unsigned char k${_index}_${_extension}[] = {\n    ${_bytes}\n};\n")
        string(APPEND _spans "std::span<const unsigned char>{k${_index}_${_extension}}, ")
    endforeach()

    string(APPEND _table
        "    {\"${_name}\", Stage::${_first}${_rest}, {${_samplers}, ${_storage_textures}, ${_storage_buffers}, "
        "${_uniform_buffers}},\n     {${_spans}}},\n")
    math(EXPR _index "${_index} + 1")
endforeach()

file(WRITE "${OUTPUT}.part"
    "// Generated by cmake/coney_shader_embed.cmake from src/platform/shaders/*.hlsl; do not edit.\n"
    "${_data}\n"
    "constexpr Shader kShaders[] = {\n${_table}};\n")
file(RENAME "${OUTPUT}.part" "${OUTPUT}")
