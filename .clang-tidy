Checks: >
  -*,bugprone-*,-bugprone-easily-swappable-parameters,clang-analyzer-*,performance-*,
  misc-definitions-in-headers,misc-redundant-expression,modernize-use-nullptr,modernize-use-override,
  -clang-analyzer-optin.cplusplus.VirtualCall
# optin.cplusplus.VirtualCall is off: it reports librw's own rw::StreamMemory destructor (a path that ends inside
# librw's header, which SYSTEM does not hide from the analyzer), and Coney itself calls no virtual method from a
# constructor or destructor.
WarningsAsErrors: '*'
HeaderFilterRegex: '.*/(src|tests)/.*'
