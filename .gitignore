# Local machine configuration (copy coney.local.example.toml)
/coney.local.toml

# Build and extraction output
/build/
/out/
*.log

# Never commit game data (LEGAL.md#no-game-data)
/game/
*.iso
*.elf
SLUS_*
*.wad
*.WAD
*.dir
*.DIR
*.xbe
*.XBE
*.xiso

# Never commit console firmware or console-specific data (BIOS, boot ROMs, EEPROM, hard-disk images)
*.bin
*.BIN
*.qcow2

# Transitional: these live inside the repo folder until the workspace move; the move deletes this block.
# Until then the game files, the emulator and the Ghidra databases (which hold the game's code) still sit
# inside the checkout and must stay ignored.
/pcsx2/
/xemu/
/tools/*
!/tools/*.ps1
!/tools/*.py
!/tools/scripts/
/research/ghidra/

# Python venv (docs tooling) and bytecode caches
/.venv/
__pycache__/
# Built docs site
/site/

# The current-state file: local only, rewritten every session
/HANDOFF.md

# Python tool caches (python/ project)
.ruff_cache/
.mypy_cache/
.pytest_cache/
/python/.venv/
