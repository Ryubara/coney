# Local machine configuration (copy coney.local.example.toml)
/coney.local.toml

# Build and extraction output
/build/
/out/
*.log

# Never commit game data (LEGAL.md#no-game-data)
/game/
*.iso
*.elf
SLUS_*
*.wad
*.WAD
*.dir
*.DIR
*.xbe
*.XBE
*.xiso

# Never commit console firmware or console-specific data (BIOS, boot ROMs, EEPROM, hard-disk images)
*.bin
*.BIN
*.qcow2

# Python venv (docs tooling) and bytecode caches
/.venv/
__pycache__/
# Built docs site
/site/

# The current-state file: local only, rewritten every session
/HANDOFF.md

# Python tool caches (python/ project)
.ruff_cache/
.mypy_cache/
.pytest_cache/
/python/.venv/
